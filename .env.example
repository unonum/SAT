# ── Turso database (server-side only — used by /api serverless functions) ──
# Get these from `turso db show <name>` and `turso db tokens create <name>`.
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── OpenAI (server-side only — RAG embeddings, vision, question generation) ──
OPENAI_API_KEY=sk-...

# ── Anthropic (server-side only — RAG question generation) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Client flag (optional) ──
# Set to "false" to force local-only mode (no API calls). Defaults to enabled.
# VITE_REMOTE_DB=false
